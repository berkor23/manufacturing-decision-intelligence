// Manufacturing Decision Engine — kalıcılık şeması.
//
// Yaklaşım: her aggregate (Conversation, RCA, Workspace) tek satırda `data: Json`
// (Postgres jsonb) olarak saklanır. Repository get/save desenine birebir uyar,
// ilişkisel eşleme karmaşıklığı ve hata riski olmadan kalıcılık sağlar.
// Not: jsonb sorgulanabilir; ileride dashboard/öğrenme (Faz 6) için gerekirse
// daha zengin ilişkisel modele geçilebilir.
//
// Uygulama in-memory ile de çalışır (PERSISTENCE=memory). Prisma yolu için:
// PERSISTENCE=prisma + DATABASE_URL + `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConversationRecord {
  id        String   @id
  status    String
  data      Json
  ownerUserId String?
  organizationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerUserId])
  @@index([organizationId])
}

model RcaRecord {
  id        String   @id
  data      Json
  ownerUserId String?
  organizationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([organizationId])
}

model WorkspaceRecord {
  id           String   @id
  methodology  String
  data         Json
  ownerUserId  String?
  organizationId String?
  revision     Int      @default(1)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([methodology])
  @@index([ownerUserId])
  @@index([organizationId])
  @@index([archivedAt])
}

/// Ek dosyaların BAYTLARI. Üst veri (ad, tür, hedef) çalışma kaydının
/// jsonb'sinde yaşar; burada yalnız içerik durur. ATTACHMENT_STORAGE=postgres
/// iken kullanılır — yerel diskin çalışmadığı serverless/çok örnekli dağıtımlar.
model AttachmentBlob {
  storageKey  String   @id
  workspaceId String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

enum AccountType {
  INDIVIDUAL
  COMPANY
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CredentialTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITATION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  accountType  AccountType
  active       Boolean      @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships Membership[]
  sessions     UserSession[]
  activities   ActivityEvent[]
  credentialTokens CredentialToken[]

  @@index([accountType])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  seatLimit   Int          @default(5)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  activities  ActivityEvent[]
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  jobTitle       String?
  department     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentialTokens CredentialToken[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model CredentialToken {
  id           String              @id @default(cuid())
  tokenHash    String              @unique
  type         CredentialTokenType
  userId       String
  membershipId String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership?         @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([membershipId])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ActivityEvent {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  workspaceId    String?
  type           String
  summary        String
  metadata       Json?
  occurredAt     DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([workspaceId])
}
